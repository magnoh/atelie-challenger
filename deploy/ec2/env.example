# Copie para .env.ec2 NA EC2. O arquivo .env.ec2 não deve ir para o Git.
# Gere uma senha hexadecimal: openssl rand -hex 24
DB_PASSWORD=SUBSTITUA_PELA_SENHA_HEXADECIMAL_GERADA

# Acesso inicial pelo IP público via HTTP:
SITE_ADDRESS=:80
APP_ORIGIN=http://SUBSTITUA_PELO_IP_PUBLICO
APP_ENV=development

# Para HTTPS, após apontar o domínio para a EC2, troque as três linhas acima:
# SITE_ADDRESS=leilao.seudominio.com
# APP_ORIGIN=https://leilao.seudominio.com
# APP_ENV=production

# Senha padrão das três contas de demonstração; somente dados simulados.
SEED_PASSWORD=Verzel2026!
# AUDIT_SECRET pode ser omitido: será gerado e preservado no volume app_data.
